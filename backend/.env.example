# ejemplo de .env necesario para la configuracion
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
SERVER_PORT=
JWT_SECRET=
# Directorio base donde se guardan las fotos de visitantes (local por defecto; cambia a un mount de S3/GCS en producción)
UPLOADS_DIR=./web/uploads/visitantes
# OAuth Client ID de Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Necesario solo si usas el login con Google en el dashboard admin
GOOGLE_CLIENT_ID=
# URL de llama-server (resúmenes de visitas y reportes de 12h) — hoy corre
# en una laptop aparte con GPU, alcanzable por Tailscale. Ej.:
# http://alberto.tailnet-name.ts.net:8081  o  http://100.x.x.x:8081
LLM_URL=
# URL pública por la que se alcanza este backend (usada para armar links
# absolutos, ej. las fotos subidas)
PUBLIC_URL=
# Ruta al JSON de cuenta de servicio de Firebase (para mandar pushes reales
# por FCM). Se descarga desde Firebase Console → Configuración del proyecto
# → Cuentas de servicio → Generar nueva clave privada. Nunca va al repo —
# el .gitignore raíz ya lo bloquea por patrón (*firebase-adminsdk*.json).
# Vacío = notificador falso que solo loguea (LogPushSender).
FIREBASE_CREDENTIALS_PATH=
