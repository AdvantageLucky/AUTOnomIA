        "/visitantes": {
            "get": {
                "description": "Devuelve, paginados, los registros de visita del admin autenticado. Filtros opcionales combinables: acceso_id, tipo_documento, q (busqueda parcial en nombre/curp/clave_lector). No incluye CURP ni clave_lector en la respuesta (ver GET /visitantes/{id} para el detalle completo)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitantes"
                ],
                "summary": "Listar visitantes del admin (dashboard)",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Numero de pagina (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Tamaño de pagina (default 20, max 100)",
                        "name": "page_size",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Acota el listado a un Acceso especifico del admin",
                        "name": "acceso_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "INE, PASAPORTE o LICENCIA",
                        "name": "tipo_documento",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Busqueda parcial por nombre, CURP o clave de lector",
                        "name": "q",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
