        "/accesos/{id}/visitantes": {
            "post": {
                "description": "Registra el ingreso de un nuevo visitante por un Acceso, subiendo la foto del documento y la de su rostro en la misma llamada",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitantes"
                ],
                "summary": "Registrar visitante",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID del acceso",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Nombre del visitante",
                        "name": "nombre",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "INE, PASAPORTE o LICENCIA",
                        "name": "tipo_documento",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Clave leida del documento",
                        "name": "clave_lector",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "CURP (18 caracteres)",
                        "name": "curp",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Foto del documento (INE/pasaporte/licencia), jpg o png",
                        "name": "foto_documento",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Foto de la cara de la persona, jpg o png",
                        "name": "foto_rostro",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/visitantes.VisitanteResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
